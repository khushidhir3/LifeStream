# ---- Core ----
DATABASE_URL="file:./dev.db"          # SQLite for dev. Production: postgresql://user:pass@host:5432/db (also set provider="postgresql" in prisma/schema.prisma)
JWT_SECRET=replace_with_a_long_random_string   # required in production
JWT_EXPIRES_IN=7d
PORT=4000
NODE_ENV=development

# Frontend URL(s), comma separated. Used for CORS and for links in emails.
CLIENT_URL=http://localhost:5173
# Optional: public site URL used in emails if different from CLIENT_URL
APP_URL=

# ---- First admin (created by `npm run seed`) ----
SEED_ADMIN_EMAIL=admin@lifestream.local
SEED_ADMIN_PASS=                       # dev default: Admin@12345. In production a random one is printed if empty.
SEED_DEMO=false                        # true = add sample donors/requests (demos only)

# Optional extra code required on the admin login screen
ADMIN_ACCESS_CODE=

# ---- Email (password reset, alerts). Without SMTP, emails are printed to the server log. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LifeStream <no-reply@yourdomain.com>"

# ---- External data ----
# Government of India Open Data (https://data.gov.in) - free key after signing up.
# Find the "Blood Bank Directory" dataset and copy its resource id (the UUID in its API URL).
# Without these, blood bank search uses OpenStreetMap, which needs no key.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_BLOOD_BANK_RESOURCE_ID=

# City/address -> map coordinates via OpenStreetMap Nominatim (free). Set false to disable.
GEOCODING_ENABLED=true
